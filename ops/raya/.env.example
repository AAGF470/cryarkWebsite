# ── RAYA backup config ──────────────────────────────────────────────────────
# On RAYA:  copy to /etc/raya-backup.env  (chmod 600, root-owned) with the
#           APPEND-ONLY key (raya-append).
# On Mac:   copy to ~/.config/raya-backup/maintain.env with the FULL key
#           (maint-full) — used by maintain.sh for prune/check.
# Never commit a filled-in copy. This .example carries placeholders only.

# restic repository on Backblaze B2:  b2:<bucket>:<path>
RESTIC_REPOSITORY=b2:raya-backups:raya

# restic encryption password — a file readable only by its owner (chmod 600).
# Keep the passphrase in your password manager too; lose it and backups are gone.
RESTIC_PASSWORD_FILE=/etc/raya-backup.pass

# Backblaze B2 application key (id + key).
#   RAYA  → raya-append  (writeFiles, NO deleteFiles)
#   Mac   → maint-full   (all capabilities, incl. deleteFiles)
B2_ACCOUNT_ID=your_b2_key_id
B2_ACCOUNT_KEY=your_b2_application_key

# Where DB dumps are staged before the snapshot (RAYA only)
DUMP_DIR=/srv/backups/dumps

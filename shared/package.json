{
  "name": "@aagf470/ui",
  "version": "0.1.3",
  "description": "Guillen Solutions shared component library — section blocks, UI primitives, design tokens, and Sanity page rendering.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AAGF470/cryarkWebsite.git",
    "directory": "shared"
  },
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./cms": {
      "import": "./dist/cms.js"
    },
    "./styles.css": "./dist/styles.css",
    "./styles/base.css": "./styles/base.css",
    "./styles/tokens.css": "./styles/tokens.css"
  },
  "files": [
    "dist",
    "styles"
  ],
  "scripts": {
    "build": "vite build --config vite.lib.config.js"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "react-router-dom": ">=6",
    "@sanity/client": ">=6",
    "@sanity/image-url": ">=1"
  },
  "peerDependenciesMeta": {
    "react-router-dom": { "optional": true },
    "@sanity/client": { "optional": true },
    "@sanity/image-url": { "optional": true }
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "vite": "^8.0.10"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}

{
  "name": "cryark",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:guillen": "vite --config apps/guillen/vite.config.js",
    "dev:gws":     "vite --config apps/guillenwebsites/vite.config.js",
    "dev:fp":      "vite --config apps/fencingpatrol/vite.config.js",
    "dev:nsl":     "vite --config apps/nsl/vite.config.js",
    "dev:freelance": "vite --config apps/freelance-template/vite.config.js",
    "build": "vite build",
    "build:guillen": "vite build --config apps/guillen/vite.config.js",
    "build:gws":     "vite build --config apps/guillenwebsites/vite.config.js",
    "build:fp":      "vite build --config apps/fencingpatrol/vite.config.js",
    "build:nsl":     "vite build --config apps/nsl/vite.config.js",
    "build:freelance": "vite build --config apps/freelance-template/vite.config.js",
